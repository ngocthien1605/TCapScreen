<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX v3 installer source for RustShot, built with cargo-wix:
      cargo install cargo-wix
      cargo wix            # produces target/wix/RustShot-<version>-x86_64.msi
  cargo-wix supplies $(var.Version), $(var.Platform), and $(var.CargoTargetBinDir).
  Paths without that variable are relative to this file (wix/).

  Per-user install: everything RustShot owns is per-user (config and logs in %APPDATA%, the
  optional HKCU Run entry), so the app installs to %LOCALAPPDATA%\Programs\RustShot without
  elevation, like other per-user apps. Every component therefore has an HKCU registry KeyPath
  (ICE38) and the folders it creates are removed on uninstall (ICE64).

  NOT BUILT OR TESTED in this repository's environment (no WiX here, and CI does not build it):
  see docs/PACKAGING.md before shipping an MSI.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="RustShot"
           UpgradeCode="7F2C1E84-3B6A-4C5D-9E21-0A1B2C3D4E5F"
           Language="1033"
           Codepage="1252"
           Manufacturer="RustShot contributors"
           Version="$(var.Version)">

    <Package Id="*"
             Keywords="Installer"
             Description="RustShot - screenshots and screen recording for Windows"
             Manufacturer="RustShot contributors"
             InstallerVersion="500"
             Languages="1033"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             SummaryCodepage="1252" />

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of RustShot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProductIcon.ico" SourceFile="..\crates\app\resources\rustshot.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ngocthien1605/rustshot" />

    <Feature Id="MainFeature" Title="RustShot" Level="1">
      <ComponentRef Id="RustShotExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="RustShot">
            <Component Id="RustShotExe" Guid="3C1A7E52-8B4D-4F0E-9D63-2A5B7C8E9F01">
              <File Id="RustShotExeFile" Source="$(var.CargoTargetBinDir)\rustshot.exe" />
              <RegistryValue Root="HKCU"
                             Key="Software\RustShot\Installer"
                             Name="exe"
                             Type="integer"
                             Value="1"
                             KeyPath="yes" />
              <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLDIR" On="uninstall" />
              <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="9B2E4D61-5C7A-4E38-A1F0-6D3C8B2A7E14">
          <Shortcut Id="RustShotShortcut"
                    Name="RustShot"
                    Target="[INSTALLDIR]rustshot.exe"
                    WorkingDirectory="INSTALLDIR"
                    Icon="ProductIcon.ico" />
          <RemoveFolder Id="CleanProgramMenu" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\RustShot\Installer"
                         Name="shortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
  </Product>
</Wix>
